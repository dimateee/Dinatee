# Добавь эти значения в Netlify → Site configuration → Environment variables
ANTHROPIC_API_KEY=sk-ant-...
BOT_TOKEN=123456789:AA...
# Необязательно
CLAUDE_MODEL=claude-sonnet-5
# Лимит длины ответа. Если распознавание обрывается — увеличь
CLAUDE_MAX_TOKENS=4000
# Поставь 1 только на время проверки в обычном браузере, потом удали
ALLOW_BROWSER_TESTING=0


# СБП: готовые ссылки оплаты от вашего эквайера/провайдера
SBP_PAYMENT_URL_MONTH=https://example.com/sbp/month
SBP_PAYMENT_URL_YEAR=https://example.com/sbp/year
