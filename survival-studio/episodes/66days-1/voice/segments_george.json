[
 {
  "key": "cold",
  "text": "Я проспал.",
  "start": 0.35,
  "end": 1.371,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Четвёртый день — и всё.",
  "start": 1.971,
  "end": 4.328,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "В октябре я решил бегать.",
  "start": 6.828,
  "end": 9.103,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "До моста и обратно — два километра.",
  "start": 9.703,
  "end": 12.398,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Маршрут нарисовал в тетради.",
  "start": 12.998,
  "end": 14.941,
  "pause_after": 1.2
 },
 {
  "key": "ch1",
  "text": "Три утра подряд я вставал в шесть тридцать.",
  "start": 16.141,
  "end": 19.358,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Луна ждала меня у ворот.",
  "start": 19.958,
  "end": 22.048,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "На четвёртый день пошёл дождь.",
  "start": 23.248,
  "end": 25.617,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Будильник я не услышал.",
  "start": 26.217,
  "end": 27.796,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Проснулся в семь сорок.",
  "start": 30.296,
  "end": 31.872,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "И решил: всё, сорвался.",
  "start": 32.472,
  "end": 34.484,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM горели три клетки.",
  "start": 35.684,
  "end": 37.502,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Четвёртая — пустая.",
  "start": 38.102,
  "end": 39.771,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Но пятая ещё не наступила.",
  "start": 40.371,
  "end": 42.635,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Наутро в семь скрипнула калитка.",
  "start": 43.835,
  "end": 46.085,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна сидела там.",
  "start": 46.685,
  "end": 47.948,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "С поводком в зубах.",
  "start": 48.548,
  "end": 49.935,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Я не побежал.",
  "start": 51.135,
  "end": 52.148,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Просто дошёл до моста.",
  "start": 52.748,
  "end": 54.412,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Тогда я записал правила.",
  "start": 55.612,
  "end": 57.215,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Кроссовки — у двери с вечера.",
  "start": 57.815,
  "end": 59.758,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Сигнал — всегда в семь.",
  "start": 60.358,
  "end": 62.494,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Нет сил бежать — иди.",
  "start": 63.094,
  "end": 65.091,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Два пропуска подряд — нельзя.",
  "start": 65.691,
  "end": 67.772,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Пятый день.",
  "start": 68.972,
  "end": 69.818,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Восьмой.",
  "start": 70.418,
  "end": 71.118,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Двенадцатый.",
  "start": 71.718,
  "end": 72.73,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На двенадцатый выпал снег.",
  "start": 75.23,
  "end": 77.506,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "И Луна впервые не встала к двери.",
  "start": 78.706,
  "end": 80.919,
  "pause_after": 2.5
 }
]