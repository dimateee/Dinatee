[
 {
  "key": "cold",
  "text": "Я проспал.",
  "start": 0.35,
  "end": 1.321,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Четвёртый день — и всё.",
  "start": 1.921,
  "end": 3.697,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "В октябре я решил бегать.",
  "start": 6.197,
  "end": 8.083,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "До моста и обратно — два километра.",
  "start": 8.683,
  "end": 11.308,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Маршрут нарисовал в тетради.",
  "start": 11.908,
  "end": 14.037,
  "pause_after": 1.2
 },
 {
  "key": "ch1",
  "text": "Три утра подряд я вставал в шесть тридцать.",
  "start": 15.237,
  "end": 18.106,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Луна ждала у калитки.",
  "start": 18.706,
  "end": 20.461,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "На четвёртый день пошёл дождь.",
  "start": 21.661,
  "end": 23.799,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Будильник я не услышал.",
  "start": 24.399,
  "end": 26.416,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Проснулся в семь сорок.",
  "start": 28.916,
  "end": 30.67,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "И решил: всё, сорвался.",
  "start": 31.27,
  "end": 33.391,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM горели три клетки.",
  "start": 34.591,
  "end": 36.432,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Четвёртая — пустая.",
  "start": 37.032,
  "end": 38.649,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Но пятая ещё не наступила.",
  "start": 39.249,
  "end": 41.331,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Наутро в семь скрипнула калитка.",
  "start": 42.531,
  "end": 44.72,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна сидела там.",
  "start": 45.32,
  "end": 46.789,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "С поводком в зубах.",
  "start": 47.389,
  "end": 48.898,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Я не побежал.",
  "start": 50.098,
  "end": 51.326,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Просто дошёл до моста.",
  "start": 51.926,
  "end": 53.711,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Тогда я записал правила.",
  "start": 54.911,
  "end": 56.795,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Кроссовки — у двери с вечера.",
  "start": 57.395,
  "end": 59.612,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Сигнал — всегда в семь.",
  "start": 60.212,
  "end": 61.826,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Нет сил бежать — иди.",
  "start": 62.426,
  "end": 64.349,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Два пропуска подряд — нельзя.",
  "start": 64.949,
  "end": 67.122,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Пятый день.",
  "start": 68.322,
  "end": 69.223,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Восьмой.",
  "start": 69.823,
  "end": 70.627,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Двенадцатый.",
  "start": 71.227,
  "end": 72.253,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На двенадцатый выпал снег.",
  "start": 74.753,
  "end": 76.714,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "И Луна впервые не встала к двери.",
  "start": 77.914,
  "end": 80.27,
  "pause_after": 2.5
 }
]