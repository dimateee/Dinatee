[
 {
  "key": "cold",
  "text": "Я проспал.",
  "start": 0.35,
  "end": 1.337,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Четвёртый день — и всё.",
  "start": 1.937,
  "end": 3.754,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "В октябре я решил бегать.",
  "start": 6.254,
  "end": 8.11,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "До моста и обратно — два километра.",
  "start": 8.71,
  "end": 11.442,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Маршрут нарисовал в тетради.",
  "start": 12.042,
  "end": 14.242,
  "pause_after": 1.2
 },
 {
  "key": "ch1",
  "text": "Три утра подряд я вставал в шесть тридцать.",
  "start": 15.442,
  "end": 18.302,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Луна ждала меня у ворот.",
  "start": 18.902,
  "end": 20.809,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "На четвёртый день пошёл дождь.",
  "start": 22.009,
  "end": 23.993,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Будильник я не услышал.",
  "start": 24.593,
  "end": 26.648,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Проснулся в семь сорок.",
  "start": 29.148,
  "end": 30.902,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "И решил: всё, сорвался.",
  "start": 31.502,
  "end": 33.655,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM горели три клетки.",
  "start": 34.855,
  "end": 36.662,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Четвёртая — пустая.",
  "start": 37.262,
  "end": 38.908,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Но пятая ещё не наступила.",
  "start": 39.508,
  "end": 41.579,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Наутро в семь скрипнула калитка.",
  "start": 42.779,
  "end": 45.004,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна сидела там.",
  "start": 45.604,
  "end": 47.07,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "С поводком в зубах.",
  "start": 47.67,
  "end": 49.146,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Я не побежал.",
  "start": 50.346,
  "end": 51.523,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Просто дошёл до моста.",
  "start": 52.123,
  "end": 53.957,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Тогда я записал правила.",
  "start": 55.157,
  "end": 56.958,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Кроссовки — у двери с вечера.",
  "start": 57.558,
  "end": 59.799,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Сигнал — всегда в семь.",
  "start": 60.399,
  "end": 61.887,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Нет сил бежать — иди.",
  "start": 62.487,
  "end": 64.442,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Два пропуска подряд — нельзя.",
  "start": 65.042,
  "end": 67.19,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Пятый день.",
  "start": 68.39,
  "end": 69.308,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Восьмой.",
  "start": 69.908,
  "end": 70.695,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Двенадцатый.",
  "start": 71.295,
  "end": 72.374,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На двенадцатый выпал снег.",
  "start": 74.874,
  "end": 76.752,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "И Луна впервые не встала к двери.",
  "start": 77.952,
  "end": 80.223,
  "pause_after": 2.5
 }
]