[
 {
  "key": "cold",
  "text": "Я проспал.",
  "start": 0.35,
  "end": 1.458,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Четвёртый день — и всё.",
  "start": 2.058,
  "end": 3.641,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "В октябре я решил бегать.",
  "start": 6.141,
  "end": 8.851,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "До моста и обратно — два километра.",
  "start": 9.451,
  "end": 12.703,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Маршрут нарисовал в тетради.",
  "start": 13.303,
  "end": 15.213,
  "pause_after": 1.2
 },
 {
  "key": "ch1",
  "text": "Три утра подряд я вставал в шесть тридцать.",
  "start": 16.413,
  "end": 19.079,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Луна ждала меня у ворот.",
  "start": 19.679,
  "end": 21.134,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "На четвёртый день пошёл дождь.",
  "start": 22.334,
  "end": 25.185,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Будильник я не услышал.",
  "start": 25.785,
  "end": 27.357,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Проснулся в семь сорок.",
  "start": 29.857,
  "end": 31.325,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "И решил: всё, сорвался.",
  "start": 31.925,
  "end": 34.499,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM горели три клетки.",
  "start": 35.699,
  "end": 37.319,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Четвёртая — пустая.",
  "start": 37.919,
  "end": 39.587,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Но пятая ещё не наступила.",
  "start": 40.187,
  "end": 42.205,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Наутро в семь скрипнула калитка.",
  "start": 43.405,
  "end": 46.07,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна сидела там.",
  "start": 46.67,
  "end": 47.821,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "С поводком в зубах.",
  "start": 48.421,
  "end": 50.314,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Я не побежал.",
  "start": 51.514,
  "end": 52.619,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Просто дошёл до моста.",
  "start": 53.219,
  "end": 54.695,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Тогда я записал правила.",
  "start": 55.895,
  "end": 58.186,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Кроссовки — у двери с вечера.",
  "start": 58.786,
  "end": 60.511,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Сигнал — всегда в семь.",
  "start": 61.111,
  "end": 63.198,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Нет сил бежать — иди.",
  "start": 63.798,
  "end": 65.966,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Два пропуска подряд — нельзя.",
  "start": 66.566,
  "end": 68.875,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Пятый день.",
  "start": 70.075,
  "end": 70.985,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Восьмой.",
  "start": 71.585,
  "end": 72.518,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Двенадцатый.",
  "start": 73.118,
  "end": 74.118,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На двенадцатый выпал снег.",
  "start": 76.618,
  "end": 79.139,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "И Луна впервые не встала к двери.",
  "start": 80.339,
  "end": 82.403,
  "pause_after": 2.5
 }
]