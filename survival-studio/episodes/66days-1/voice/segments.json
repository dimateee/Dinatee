[
 {
  "key": "cold",
  "text": "Я проспал.",
  "start": 0.35,
  "end": 1.365,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Четвёртый день — и всё.",
  "start": 1.965,
  "end": 3.693,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "В октябре я решил бегать.",
  "start": 6.193,
  "end": 8.237,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "До моста и обратно — два километра.",
  "start": 8.837,
  "end": 11.741,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Маршрут нарисовал в тетради.",
  "start": 12.341,
  "end": 14.071,
  "pause_after": 1.2
 },
 {
  "key": "ch1",
  "text": "Три утра подряд я вставал в шесть тридцать.",
  "start": 15.271,
  "end": 18.503,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Луна ждала меня у ворот.",
  "start": 19.103,
  "end": 21.023,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "На четвёртый день пошёл дождь.",
  "start": 22.223,
  "end": 24.05,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Будильник я не услышал.",
  "start": 24.65,
  "end": 26.208,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Проснулся в семь сорок.",
  "start": 28.708,
  "end": 30.09,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "И решил: всё, сорвался.",
  "start": 30.69,
  "end": 33.723,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM горели три клетки.",
  "start": 34.923,
  "end": 36.777,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Четвёртая — пустая.",
  "start": 37.377,
  "end": 39.128,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Но пятая ещё не наступила.",
  "start": 39.728,
  "end": 42.599,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Наутро в семь скрипнула калитка.",
  "start": 43.799,
  "end": 45.814,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна сидела там.",
  "start": 46.414,
  "end": 48.074,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "С поводком в зубах.",
  "start": 48.674,
  "end": 50.16,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Я не побежал.",
  "start": 51.36,
  "end": 52.356,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Просто дошёл до моста.",
  "start": 52.956,
  "end": 54.386,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Тогда я записал правила.",
  "start": 55.586,
  "end": 57.219,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Кроссовки — у двери с вечера.",
  "start": 57.819,
  "end": 60.06,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Сигнал — всегда в семь.",
  "start": 60.66,
  "end": 62.575,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Нет сил бежать — иди.",
  "start": 63.175,
  "end": 65.19,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Два пропуска подряд — нельзя.",
  "start": 65.79,
  "end": 67.855,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Пятый день.",
  "start": 69.055,
  "end": 69.825,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Восьмой.",
  "start": 70.425,
  "end": 71.222,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Двенадцатый.",
  "start": 71.822,
  "end": 72.832,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На двенадцатый выпал снег.",
  "start": 75.332,
  "end": 77.24,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "И Луна впервые не встала к двери.",
  "start": 78.44,
  "end": 80.53,
  "pause_after": 2.5
 }
]