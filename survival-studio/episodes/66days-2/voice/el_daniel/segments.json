[
 {
  "key": "cold",
  "text": "Минус восемь.",
  "start": 0.35,
  "end": 1.267,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Ещё темно.",
  "start": 1.867,
  "end": 2.657,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Я у калитки один.",
  "start": 3.257,
  "end": 4.43,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "Луна порезала лапу о лёд.",
  "start": 6.93,
  "end": 8.875,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Ветеринар сказал: неделю покоя.",
  "start": 9.475,
  "end": 12.126,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "По утрам она лежала у печки.",
  "start": 12.726,
  "end": 14.867,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "Без неё выходить не хотелось.",
  "start": 16.067,
  "end": 18.008,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Мотивации — никакой.",
  "start": 18.608,
  "end": 20.149,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Но в семь я стоял у калитки.",
  "start": 22.649,
  "end": 24.887,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Потому что было семь.",
  "start": 25.487,
  "end": 26.459,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM серия — пятнадцать дней.",
  "start": 27.659,
  "end": 30.38,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Пусть хоть шагом, но шестнадцать.",
  "start": 30.98,
  "end": 33.397,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Зимой правила другие.",
  "start": 34.597,
  "end": 36.076,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Одевайся слоями.",
  "start": 36.676,
  "end": 38.708,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Светоотражатель — в темноте тебя не видно.",
  "start": 39.308,
  "end": 42.652,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Маршрут короче.",
  "start": 43.252,
  "end": 44.413,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Разминка — дома.",
  "start": 45.013,
  "end": 46.731,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Неделю я ходил один.",
  "start": 47.931,
  "end": 49.447,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Иногда бегом, иногда нет.",
  "start": 50.047,
  "end": 51.674,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "На девятнадцатый день",
  "start": 52.874,
  "end": 54.127,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна снова сидела у калитки.",
  "start": 54.727,
  "end": 56.688,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Потом январь.",
  "start": 57.888,
  "end": 58.985,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Потом пришёл февраль.",
  "start": 59.585,
  "end": 60.913,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На шестьдесят шестой день я понял:",
  "start": 63.413,
  "end": 65.755,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "я больше не спорю с собой.",
  "start": 66.355,
  "end": 68.101,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "А сосед через забор спросил:",
  "start": 69.301,
  "end": 71.091,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "«Возьмёте меня завтра?»",
  "start": 71.691,
  "end": 72.785,
  "pause_after": 2.5
 }
]