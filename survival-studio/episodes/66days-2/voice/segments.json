[
 {
  "key": "cold",
  "text": "Минус восемь.",
  "start": 0.35,
  "end": 1.501,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Ещё темно.",
  "start": 2.101,
  "end": 3.257,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Я у калитки один.",
  "start": 3.857,
  "end": 5.514,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "Луна порезала лапу о лёд.",
  "start": 8.014,
  "end": 9.95,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Ветеринар сказал: неделю покоя.",
  "start": 10.55,
  "end": 13.26,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "По утрам она лежала у печки.",
  "start": 13.86,
  "end": 16.077,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "Без неё выходить не хотелось.",
  "start": 17.277,
  "end": 19.422,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Мотивации — никакой.",
  "start": 20.021,
  "end": 21.673,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Но в семь я стоял у калитки.",
  "start": 24.173,
  "end": 26.243,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Потому что было семь.",
  "start": 26.843,
  "end": 28.43,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM серия — пятнадцать дней.",
  "start": 29.63,
  "end": 31.888,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Пусть хоть шагом, но шестнадцать.",
  "start": 32.488,
  "end": 34.698,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Зимой правила другие.",
  "start": 35.898,
  "end": 37.44,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Одевайся слоями.",
  "start": 38.04,
  "end": 39.55,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Светоотражатель — в темноте тебя не видно.",
  "start": 40.15,
  "end": 43.086,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Маршрут короче.",
  "start": 43.686,
  "end": 45.029,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Разминка — дома.",
  "start": 45.629,
  "end": 46.981,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Неделю я ходил один.",
  "start": 48.181,
  "end": 50.046,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Иногда бегом, иногда нет.",
  "start": 50.646,
  "end": 52.751,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "На девятнадцатый день",
  "start": 53.951,
  "end": 55.487,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна снова сидела у калитки.",
  "start": 56.087,
  "end": 58.326,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Потом январь.",
  "start": 59.526,
  "end": 60.739,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Потом пришёл февраль.",
  "start": 61.339,
  "end": 62.891,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На шестьдесят шестой день я понял:",
  "start": 65.391,
  "end": 67.729,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "я больше не спорю с собой.",
  "start": 68.329,
  "end": 70.223,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "А сосед через забор спросил:",
  "start": 71.423,
  "end": 73.554,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "«Возьмёте меня завтра?»",
  "start": 74.154,
  "end": 75.726,
  "pause_after": 2.5
 }
]