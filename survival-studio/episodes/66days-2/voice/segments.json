[
 {
  "key": "cold",
  "text": "Минус восемь.",
  "start": 0.35,
  "end": 1.503,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Темно.",
  "start": 2.103,
  "end": 2.79,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Я у калитки один.",
  "start": 3.39,
  "end": 4.904,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "Луна порезала лапу о лёд.",
  "start": 7.404,
  "end": 9.36,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Ветеринар сказал: неделю покоя.",
  "start": 9.96,
  "end": 12.593,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Утром она лежала у печки.",
  "start": 13.193,
  "end": 15.304,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "Без неё выходить не хотелось.",
  "start": 16.504,
  "end": 18.595,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Мотивации — никакой.",
  "start": 19.195,
  "end": 20.8,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Но в семь я стоял у калитки.",
  "start": 23.3,
  "end": 25.322,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Потому что было семь.",
  "start": 25.922,
  "end": 27.524,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM серия — пятнадцать дней.",
  "start": 28.724,
  "end": 30.963,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Пусть хоть шагом, но шестнадцать.",
  "start": 31.563,
  "end": 33.824,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Зимой правила другие.",
  "start": 35.024,
  "end": 36.579,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Одевайся слоями.",
  "start": 37.179,
  "end": 38.661,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Светоотражатель — в темноте тебя не видно.",
  "start": 39.261,
  "end": 42.134,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Маршрут короче.",
  "start": 42.734,
  "end": 44.019,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Разминка — дома.",
  "start": 44.619,
  "end": 45.935,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Неделю я ходил один.",
  "start": 47.135,
  "end": 49.009,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Иногда бегом, иногда нет.",
  "start": 49.609,
  "end": 51.61,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "На девятнадцатый день",
  "start": 52.81,
  "end": 54.375,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна снова сидела у калитки.",
  "start": 54.975,
  "end": 57.169,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Потом январь.",
  "start": 58.369,
  "end": 59.585,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Февраль.",
  "start": 60.185,
  "end": 60.852,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На шестьдесят шестой день я понял:",
  "start": 63.352,
  "end": 65.626,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "я больше не спорю с собой.",
  "start": 66.226,
  "end": 68.14,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "А сосед через забор спросил:",
  "start": 69.34,
  "end": 71.399,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "«Возьмёте меня завтра?»",
  "start": 71.999,
  "end": 73.618,
  "pause_after": 2.5
 }
]