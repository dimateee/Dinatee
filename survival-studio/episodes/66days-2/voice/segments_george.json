[
 {
  "key": "cold",
  "text": "Минус восемь.",
  "start": 0.35,
  "end": 1.465,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Ещё темно.",
  "start": 2.065,
  "end": 3.133,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Я у калитки один.",
  "start": 3.733,
  "end": 5.405,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "Луна порезала лапу о лёд.",
  "start": 7.905,
  "end": 9.858,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Ветеринар сказал: неделю покоя.",
  "start": 10.458,
  "end": 13.076,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "По утрам она лежала у печки.",
  "start": 13.676,
  "end": 15.832,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "Без неё выходить не хотелось.",
  "start": 17.032,
  "end": 18.985,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Мотивации — никакой.",
  "start": 19.585,
  "end": 21.536,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Но в семь я стоял у калитки.",
  "start": 24.036,
  "end": 26.068,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Потому что было семь.",
  "start": 26.668,
  "end": 28.045,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM серия — пятнадцать дней.",
  "start": 29.245,
  "end": 31.566,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Пусть хоть шагом, но шестнадцать.",
  "start": 32.166,
  "end": 34.509,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Зимой правила другие.",
  "start": 35.709,
  "end": 37.37,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Одевайся слоями.",
  "start": 37.97,
  "end": 39.795,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Светоотражатель — в темноте тебя не видно.",
  "start": 40.395,
  "end": 43.832,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Маршрут короче.",
  "start": 44.432,
  "end": 45.918,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Разминка — дома.",
  "start": 46.518,
  "end": 47.83,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Неделю я ходил один.",
  "start": 49.03,
  "end": 50.727,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Иногда бегом, иногда нет.",
  "start": 51.327,
  "end": 53.739,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "На девятнадцатый день",
  "start": 54.939,
  "end": 56.304,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна снова сидела у калитки.",
  "start": 56.904,
  "end": 59.004,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Потом январь.",
  "start": 60.204,
  "end": 61.26,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Потом пришёл февраль.",
  "start": 61.86,
  "end": 63.271,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На шестьдесят шестой день я понял:",
  "start": 65.771,
  "end": 68.325,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "я больше не спорю с собой.",
  "start": 68.925,
  "end": 70.693,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "А сосед через забор спросил:",
  "start": 71.893,
  "end": 74.077,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "«Возьмёте меня завтра?»",
  "start": 74.677,
  "end": 76.143,
  "pause_after": 2.5
 }
]