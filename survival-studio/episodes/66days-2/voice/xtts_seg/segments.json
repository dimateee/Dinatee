[
 {
  "key": "cold",
  "text": "Минус восемь.",
  "start": 0.35,
  "end": 1.585,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Ещё темно.",
  "start": 2.185,
  "end": 3.184,
  "pause_after": 0.6
 },
 {
  "key": "cold",
  "text": "Я у калитки один.",
  "start": 3.784,
  "end": 5.346,
  "pause_after": 2.5
 },
 {
  "key": "ch1",
  "text": "Луна порезала лапу о лёд.",
  "start": 7.846,
  "end": 9.508,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "Ветеринар сказал: неделю покоя.",
  "start": 10.108,
  "end": 12.589,
  "pause_after": 0.6
 },
 {
  "key": "ch1",
  "text": "По утрам она лежала у печки.",
  "start": 13.189,
  "end": 15.199,
  "pause_after": 1.2
 },
 {
  "key": "ch2",
  "text": "Без неё выходить не хотелось.",
  "start": 16.399,
  "end": 18.765,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Мотивации — никакой.",
  "start": 19.365,
  "end": 21.267,
  "pause_after": 2.5
 },
 {
  "key": "ch2",
  "text": "Но в семь я стоял у калитки.",
  "start": 23.767,
  "end": 26.189,
  "pause_after": 0.6
 },
 {
  "key": "ch2",
  "text": "Потому что было семь.",
  "start": 26.789,
  "end": 28.064,
  "pause_after": 1.2
 },
 {
  "key": "app",
  "text": "В RITM серия — пятнадцать дней.",
  "start": 29.264,
  "end": 31.444,
  "pause_after": 0.6
 },
 {
  "key": "app",
  "text": "Пусть хоть шагом, но шестнадцать.",
  "start": 32.044,
  "end": 34.301,
  "pause_after": 1.2
 },
 {
  "key": "how",
  "text": "Зимой правила другие.",
  "start": 35.501,
  "end": 37.503,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Одевайся слоями.",
  "start": 38.103,
  "end": 39.409,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Светоотражатель — в темноте тебя не видно.",
  "start": 40.009,
  "end": 43.434,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Маршрут короче.",
  "start": 44.034,
  "end": 45.244,
  "pause_after": 0.6
 },
 {
  "key": "how",
  "text": "Разминка — дома.",
  "start": 45.844,
  "end": 47.539,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "Неделю я ходил один.",
  "start": 48.739,
  "end": 50.629,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Иногда бегом, иногда нет.",
  "start": 51.229,
  "end": 53.268,
  "pause_after": 1.2
 },
 {
  "key": "ch3",
  "text": "На девятнадцатый день",
  "start": 54.468,
  "end": 56.682,
  "pause_after": 0.6
 },
 {
  "key": "ch3",
  "text": "Луна снова сидела у калитки.",
  "start": 57.282,
  "end": 59.394,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "Потом январь.",
  "start": 60.594,
  "end": 61.952,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "Потом пришёл февраль.",
  "start": 62.552,
  "end": 64.242,
  "pause_after": 2.5
 },
 {
  "key": "ch4",
  "text": "На шестьдесят шестой день я понял:",
  "start": 66.742,
  "end": 70.392,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "я больше не спорю с собой.",
  "start": 70.992,
  "end": 72.722,
  "pause_after": 1.2
 },
 {
  "key": "ch4",
  "text": "А сосед через забор спросил:",
  "start": 73.922,
  "end": 76.06,
  "pause_after": 0.6
 },
 {
  "key": "ch4",
  "text": "«Возьмёте меня завтра?»",
  "start": 76.66,
  "end": 77.96,
  "pause_after": 2.5
 }
]