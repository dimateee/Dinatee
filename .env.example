# Эти значения добавляются в Netlify → Project configuration → Environment variables.
# Сам файл с настоящими значениями в GitHub НЕ загружаем.

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=123456789:AA...

# Любое слово из латиницы и цифр, от 8 символов. Защищает бота и ссылку настройки
WEBHOOK_SECRET=pyexdg_secret_2026

# Ваш chat id: напишите боту /myid и вставьте число сюда. Сюда приходят заказы и сообщения
ADMIN_CHAT_ID=123456789

# Необязательно: адрес сайта, если он отличается от основного адреса Netlify
# SITE_URL=https://pyexdg.netlify.app
