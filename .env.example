# Скопируйте этот файл в .env и впишите ключи.

# Обязательно: ключ авторизации GigaChat (Authorization key) —
# https://developers.sber.ru/studio → проект GigaChat API → «Настроить API» → «Получить ключ»
GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS   # для юрлиц: GIGACHAT_API_B2B или GIGACHAT_API_CORP

# Необязательно: голос ElevenLabs. Без ключа Джарвис говорит системным голосом.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Тонкая настройка (значения по умолчанию) ---
# JARVIS_MODEL=GigaChat-2-Max      # GigaChat-2-Pro и GigaChat-2 дешевле, но хуже вызывают функции
# GIGACHAT_VERIFY_SSL=off          # on — проверять сертификат Сбера (нужен корневой сертификат Минцифры)
# GIGACHAT_CA_BUNDLE=              # путь к файлу корневого сертификата Минцифры, если VERIFY_SSL=on
# JARVIS_CONFIRM=on                # спрашивать «да/нет» перед командами оболочки и удалением
# JARVIS_LANGUAGE=ru
# JARVIS_WHISPER_MODEL=small       # tiny | base | small | medium | large-v3 — точнее, но медленнее
# JARVIS_WHISPER_DEVICE=cpu        # cuda — если есть видеокарта NVIDIA
# JARVIS_MIC_THRESHOLD=0.012       # поднимите, если срабатывает на шум; опустите, если не слышит
# JARVIS_FOLLOWUP_SECONDS=8        # сколько секунд после ответа можно говорить без слова «Джарвис»
# JARVIS_SYSTEM_VOICE=Milena       # голос macOS (список: say -v ?)
