# Нужны только для необязательной кнопки «Играть» по команде /start (netlify/functions/bot.mjs).
# Добавляются в Netlify: Site configuration → Environment variables. В GitHub не загружать!
BOT_TOKEN=123456789:AA...токен_от_BotFather
# Любая случайная строка: защищает адрес вебхука от чужих запросов (можно не задавать)
WEBHOOK_SECRET=
# Адрес игры, если он отличается от адреса сайта Netlify (обычно не нужен)
WEBAPP_URL=
