# Добавь эти значения в Netlify → Site configuration → Environment variables

# Токен бота из @BotFather
BOT_TOKEN=123456789:AA...
# Адрес приложения после деплоя (для кнопки в боте и возврата после оплаты)
APP_URL=https://имя.netlify.app

# Цена подписки
PRICE_RUB=150
# Цена в Telegram Stars за 30 дней (Telegram разрешает автопродление только раз в 30 дней)
PRICE_STARS=100

# ЮKassa — оплата картой и по СБП в рублях (личный кабинет yookassa.ru → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет в адресе вебхука ЮKassa: /api/yookassa-webhook?secret=...
YOOKASSA_WEBHOOK_SECRET=придумай-длинную-строку
# Почта для чеков по 54-ФЗ (если в ЮKassa включены чеки). Иначе оставь пустым
RECEIPT_EMAIL=

# Секрет для вебхука Telegram (передаётся в setWebhook как secret_token)
TELEGRAM_WEBHOOK_SECRET=придумай-другую-длинную-строку

# Поставь 1 только на время проверки в обычном браузере, потом удали
ALLOW_BROWSER_TESTING=0
SUPPORT_CONTACT=@ваш_логин_поддержки
