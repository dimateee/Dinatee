# Добавь эти значения в Netlify → Site configuration → Environment variables
BOT_TOKEN=123456789:AA...

# ============ Распознавание еды и голосовой помощник ============
# Какой провайдер использовать. По умолчанию — gigachat (Sber): работает без VPN, оплата в рублях.
# gemini — бесплатно (без карты), но получить ключ обычно нужно через VPN — Google ограничивает
#          доступ к aistudio.google.com по IP из России; сами вызовы с сервера потом идут без VPN.
# openrouter — тоже бесплатно (есть бесплатные модели с суффиксом ":free", без карты), и в отличие
#          от Gemini регистрация доступна без VPN. Лимит у бесплatных моделей примерно 20
#          запросов в минуту / 200 в день — для личного использования должно быть достаточно.
# anthropic — платный вариант, недоступен из России напрямую.
AI_PROVIDER=gigachat

# --- GigaChat (developers.sber.ru → Studio → GigaChat API → Настройки API → Authorization key) ---
GIGACHAT_AUTH_KEY=
# Необязательно: GIGACHAT_API_PERS — для физлиц (по умолчанию), GIGACHAT_API_B2B — для ИП/юрлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: конкретная модель. Уточни актуальное название и какая сейчас самая мощная
# версия с поддержкой Vision (распознавание фото) в своём личном кабинете — у Sber они
# периодически меняются, называются и заменяются (например, время от времени появляются
# модели новее Max — стоит время от времени проверять раздел моделей в документации Sber Studio).
GIGACHAT_MODEL=GigaChat-2-Max
# Необязательно: сколько токенов разрешить на ответ. Раньше не передавалось вообще — на сложной
# тарелке с несколькими продуктами ответ мог обрезаться на середине JSON. 2000 — с запасом.
GIGACHAT_MAX_TOKENS=2000
# Необязательно: температура (случайность ответа). Для более стабильного счёта калорий можно
# понизить до 0.1–0.2 — но это также сделает рецепты от ИИ более однообразными, они идут через
# тот же провайдер.
GIGACHAT_TEMPERATURE=0.3

# --- Gemini (aistudio.google.com → Get API key) — только если выбран AI_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4000

# --- OpenRouter (openrouter.ai → Sign Up, обычной почтой, без VPN → Keys → Create key) —
#     только если выбран AI_PROVIDER=openrouter. Бесплатная модель по умолчанию ниже поддерживает
#     фото; если она станет недоступна/перегружена — замени на другую с суффиксом ":free" из
#     каталога openrouter.ai/models (фильтр по модальности "image→text").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_MAX_TOKENS=4000

# --- Anthropic — только если выбран AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4000

# Поставь 1 только на время проверки в обычном браузере, потом удали
ALLOW_BROWSER_TESTING=0

# Необязательно: адрес приложения для кнопки «Открыть RITM» в боте.
# Если не задан — берётся адрес этого сайта
WEB_APP_URL=

# ============ Оплата через Platega (личный кабинет → Настройки проекта) ============
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Необязательно: способ оплаты (2 — СБП) и куда вернуть человека после оплаты (по умолчанию — в бота)
PLATEGA_METHOD=2
PAYMENT_RETURN_URL=

# ============ Промокоды на Pro ============
# Telegram ID (не юзернейм!) тех, кому в приложении доступен экран создания промокодов —
# через запятую, без пробелов: 123456789,987654321
# Свой числовой ID узнать можно, например, у бота @userinfobot в Telegram.
# Если переменная пустая или не задана — экран создания кодов недоступен никому (сами коды,
# уже кем-то созданные, при этом продолжат активироваться как обычно).
ADMIN_TG_IDS=

# ============ Сайт и приложение на телефон — всё необязательно ============
# Секрет для подписи входа на сайте. Если не задан — выводится из BOT_TOKEN.
# Смена этого значения разлогинит всех на сайте (Mini App не затронет).
SESSION_SECRET=
# Адрес сайта для кнопки «Сайт и приложение на телефон» в боте. По умолчанию — адрес этого сайта.
SITE_URL=
# Куда вернуть человека после оплаты с сайта. По умолчанию — https://<сайт>/app?payment=return
WEB_PAYMENT_RETURN_URL=
# Username бота без @. По умолчанию сервер узнаёт его сам у Telegram.
BOT_USERNAME=
# Ссылка на APK для Android (см. README → «APK для Android»), например /download/ritm.apk.
# Переменная со словом VITE_ попадает в сборку сайта — после изменения нужен новый деплой.
VITE_ANDROID_APK_URL=

# Яндекс Метрика: номер счётчика (только цифры) — с metrika.yandex.ru → «Добавить счётчик».
# Пусто — аналитика выключена и скрипт Метрики не грузится. Нужен новый деплой после изменения.
# Цели (Настройки счётчика → Цели → «JavaScript-событие»), см. README → «Аналитика».
VITE_YM_ID=
